{
  "name": "synclet",
  "version": "2.1.0",
  "description": "CLI interface for syncing with Synclet (formerly ConfigMesh)",
  "homepage": "https://synclet.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalvibeshq/synclet-cli.git",
    "directory": "npm"
  },
  "keywords": [
