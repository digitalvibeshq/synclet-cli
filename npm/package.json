    "@digitalvibeshq/synclet-linux-x64": "2.1.0",
    "@digitalvibeshq/synclet-linux-arm": "2.1.0",
    "@digitalvibeshq/synclet-win32-arm64": "2.1.0",
    "@digitalvibeshq/synclet-win32-x64": "2.1.0"
